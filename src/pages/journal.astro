---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Picture } from 'astro:assets';
import { img } from '../utils/images';
import { SOCIAL_LINKS } from '../data/site';

const INSTAGRAM_URL = SOCIAL_LINKS[0].url;

const articles = [
  {
    tag: 'Bien-⁠être',
    title: '5 rituels du matin pour commencer la journée en douceur',
    excerpt: 'Des gestes simples, inspirés des traditions afro-⁠caribéennes, pour ancrer votre matinée dans la sérénité.',
    date: 'À paraître',
    image: 'about/fondatrice-masoda',
    alt: 'Portrait d’une femme tenant un verre',
  },
  {
    tag: 'Créativité',
    title: 'Oser créer sans jugement : le pouvoir de l’art intuitif',
    excerpt: 'Pourquoi peindre sans règle peut transformer votre rapport à vous-même et libérer votre expression.',
    date: 'En écriture',
    image: 'home/atelier-paint-jam',
    alt: 'Des personnes peignent sur des toiles autour d’une table',
  },
  {
    tag: 'Plantes',
    title: 'Les plantes africaines anti-stress à redécouvrir',
    excerpt: 'Tisanes, racines et infusions : les trésors végétaux du continent et des îles, à intégrer au quotidien.',
    date: 'En préparation',
    image: 'collaborators/collaborateur-3',
    alt: 'Bocaux de plantes séchées et boîtes d’infusions sur une table',
  },
  {
    tag: 'Artisanat',
    title: 'Baya : l’histoire des perles de taille',
    excerpt: 'Symbole de féminité et d’ancrage, la baya raconte un héritage transmis de femme à femme.',
    date: 'À paraître',
    image: 'home/atelier-baya',
    alt: 'Baya de perles colorées sur un présentoir, avec une boîte de perles',
  },
  {
    tag: 'Communauté',
    title: 'Pourquoi les cercles de femmes nous font tant de bien',
    excerpt: 'La force du collectif féminin : un espace de parole, d’écoute et de soutien qui transforme.',
    date: 'En écriture',
    image: 'home/communaute-masoda',
    alt: 'Tablée d’atelier : création de baya, boîtes de perles et fleurs roses',
  },
  {
    tag: 'Identité',
    title: 'Massoda, une parole sincère sur le bien-⁠être afro-⁠caribéen',
    excerpt: 'Comment la fondatrice imagine un espace ancré, exigeant et profondément chaleureux.',
    date: 'En préparation',
    image: 'about/fondatrice-masoda',
    alt: 'Portrait d’une femme tenant un verre',
  },
];

const pageHeader = {
  "title": "Inspirations & ressources",
  "lede": "Le journal Massoda se construit progressivement : voici les premiers sujets qui s’écrivent autour du bien-⁠être, de la créativité et des cultures afro-⁠caribéennes."
};
---

<BaseLayout noindex title="Journal — Les Ateliers Massoda" description="Inspirations, bien-être et culture afro-caribéenne. Articles et ressources pour prendre soin de soi autrement.">

  <PageHeader {...pageHeader} />

  <section class="section">
    <div class="container">
      <div class="journal-grid">
        {articles.map((article, i) => (
          <article class="card">
            <div class="journal-image-wrap">
              <Picture
                src={img(article.image)}
                alt={article.alt}
                formats={['avif', 'webp']}
                widths={[400, 640, 900]}
                sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw"
                class="journal-image"
                loading="lazy"
                width={img(article.image).width}
                height={img(article.image).height}
              />
            </div>
            <div class="card__body">
              <div class="journal-meta">
                <span class="card__tag">{article.tag}</span>
                <span class="journal-date">{article.date}</span>
              </div>
              <h3 class="card__title">{article.title}</h3>
              <p class="card__text">{article.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section journal-cta-section">
    <div class="container container--narrow">
      <div class="journal-cta">
        <h2 class="heading-4">Le journal s’écrit en ce moment.</h2>
        <p>Les premiers articles arrivent par vagues. Suivez-nous sur Instagram pour suivre leur publication.</p>
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--primary">
          Suivre sur Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>

  .journal-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .journal-image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-warm);
  }

  .journal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .journal-image-wrap :global(picture) {
    width: 100%;
    height: 100%;
  }

  /* Cards are not yet clickable — keep them visually static. */
  .journal-grid .card {
    cursor: default;
  }

  .journal-grid .card:hover {
    transform: none;
    box-shadow: var(--shadow-sm);
  }

  .journal-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .journal-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .journal-cta-section {
    background: var(--color-bg-light);
  }

  .journal-cta {
    text-align: center;
  }

  .journal-cta h2 {
    margin-bottom: var(--space-4);
  }

  .journal-cta p {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .journal-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .journal-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
