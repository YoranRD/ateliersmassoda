---
import { getNavHref } from '../../utils/nav';
import { getReservationCta, HERO_MEDIA } from '../../data/site';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;

/* Sans billetterie confirmée, le CTA principal descend vers la section
   des prochains ateliers plutôt que de promettre une réservation. */
const cta = getReservationCta(`${getNavHref('', base)}#prochains-ateliers`);

/* MASSODA_MISSING:HERO_VIDEO — tant que la vidéo réelle n'est pas déposée,
   on garde l'image existante. Renseigner HERO_MEDIA.videoSrc dans
   src/data/site.ts suffit à basculer sur la balise <video>. */
const hasVideo = Boolean(HERO_MEDIA.videoSrc);
const posterUrl = HERO_MEDIA.posterSrc ? `${basePath}${HERO_MEDIA.posterSrc}` : undefined;
const fallbackUrl = `${basePath}${HERO_MEDIA.fallbackImage}`;
---

<section class="hero">
  <div class="hero__halo" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content reveal">
      <span class="overline">Culture · Créativité · Bien-être</span>
      <h1 class="heading-1 hero__title">Les Ateliers Massoda</h1>
      <p class="subtitle hero__subtitle">
        Explorer les cultures afro-caribéennes pour réinventer son art de vivre.
      </p>
      <div class="hero__actions">
        <a
          href={cta.href}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener' : undefined}
          class="btn btn--primary"
          data-massoda-placeholder={cta.isPlaceholder ? cta.placeholderId : undefined}
        >
          {cta.label}
        </a>
        <a href={getNavHref('ateliers', base)} class="btn btn--outline">
          Voir tous les ateliers
        </a>
      </div>
    </div>

    <div class="hero__visual reveal reveal-delay-2">
      <div class="hero__media-frame">
        {hasVideo ? (
          <video
            class="hero__media"
            src={`${basePath}${HERO_MEDIA.videoSrc}`}
            poster={posterUrl}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={HERO_MEDIA.fallbackAlt}
          >
            <img src={fallbackUrl} alt={HERO_MEDIA.fallbackAlt} width="960" height="1200" />
          </video>
        ) : (
          <img
            src={fallbackUrl}
            alt={HERO_MEDIA.fallbackAlt}
            class="hero__media"
            width="960"
            height="1200"
            decoding="async"
            fetchpriority="high"
            data-massoda-placeholder="HERO_VIDEO"
          />
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-16) var(--space-20);
    background: var(--color-bg);
  }

  .hero__halo {
    position: absolute;
    top: -120px;
    right: -80px;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-warm) 22%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero__content {
    max-width: 600px;
  }

  .hero__title {
    margin-top: var(--space-4);
    color: var(--color-text);
  }

  .hero__subtitle {
    margin-top: var(--space-6);
    max-width: 30ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__media-frame {
    width: 100%;
    max-width: 480px;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, var(--color-surface-warm) 0%, var(--color-bg-warm) 100%);
    border: 1px solid var(--color-border);
  }

  .hero__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--space-24) var(--space-32);
    }

    .hero__halo {
      width: 700px;
      height: 700px;
      top: -200px;
      right: -100px;
    }

    .hero__inner {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
