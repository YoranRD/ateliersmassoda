---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Picture } from 'astro:assets';
import { img } from '../utils/images';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { SOCIAL_LINKS } from '../data/site';

const INSTAGRAM_URL = SOCIAL_LINKS[0].url;
import { getNavHref } from '../utils/nav';

const base = import.meta.env.BASE_URL;

const categories = [
  {
    name: 'Baya',
    description: 'Perles de taille traditionnelles, portées pour la féminité, l’ancrage et la confiance en soi.',
    image: 'home/atelier-baya',
    alt: 'Baya de perles colorées sur un présentoir, avec une boîte de perles',
    badge: 'Première vague',
  },
  {
    name: 'Plantes africaines',
    description: 'Plantes médicinales et infusions inspirées des traditions africaines et caribéennes.',
    image: 'collaborators/collaborateur-3',
    alt: 'Bocaux de plantes séchées et boîtes d’infusions sur une table',
    badge: 'Première vague',
  },
  {
    name: 'Nutrition anti-stress',
    description: 'Compléments naturels et superaliments pour apaiser le corps et l’esprit.',
    image: null,
    badge: 'En préparation',
  },
  {
    name: 'Déco',
    description: 'Objets décoratifs chaleureux, inspirés de l’artisanat afro-⁠caribéen.',
    image: null,
    badge: 'En préparation',
  },
  {
    name: 'Art',
    description: 'Œuvres, prints et créations pour habiller votre intérieur avec sens.',
    image: null,
    badge: 'En préparation',
  },
];

const pageHeader = {
  "title": "Une sélection en préparation",
  "lede": "Voici un aperçu de la future boutique Massoda. Une sélection curatée d’objets de bien-⁠être, d’artisanat et de lifestyle afro-⁠caribéen, dévoilée par vagues."
};
---

<BaseLayout noindex title="Boutique — Les Ateliers Massoda" description="Découvrez notre sélection curatée d'objets de bien-être, déco et lifestyle afro-caribéen.">

  <PageHeader {...pageHeader} />

  <section class="section">
    <div class="container">
      <div class="boutique-grid">
        {categories.map((cat, i) => (
          <article class="boutique-card">
            {cat.image ? (
              <div class="boutique-card__image-wrap">
                <Picture
                  src={img(cat.image)}
                  alt={cat.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 640, 900]}
                  sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 100vw"
                  class="boutique-card__image"
                  loading="lazy"
                  width={img(cat.image).width}
                  height={img(cat.image).height}
                />
              </div>
            ) : (
              <div class="boutique-card__image-wrap">
                <MediaPlaceholder index={i} caption="Sélection à venir" label={`${cat.name} — Sélection à venir`} />
              </div>
            )}
            <h3 class="boutique-card__title">{cat.name}</h3>
            <p class="boutique-card__text">{cat.description}</p>
            <span class={`boutique-card__badge boutique-card__badge--${cat.image ? 'soon' : 'later'}`}>{cat.badge}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section boutique-notice">
    <div class="container container--narrow">
      <div class="boutique-notice__inner">
        <h2 class="heading-4">La boutique se construit, vague après vague.</h2>
        <p>Pour suivre le lancement de chaque catégorie, rendez-vous sur Instagram — ou écrivez-nous directement si vous avez un projet ou une question.</p>
        <div class="boutique-notice__actions">
          <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--primary">
            Suivre sur Instagram
          </a>
          <a href={getNavHref('contact', base)} class="btn btn--ghost">
            Nous écrire
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>

  .boutique-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .boutique-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
    position: relative;
  }

  .boutique-card__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-5);
    background: var(--color-surface-warm);
  }

  .boutique-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .boutique-card__image-wrap :global(picture) {
    width: 100%;
    height: 100%;
  }

  .boutique-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .boutique-card__text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-4);
  }

  .boutique-card__badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text);
    background: var(--color-warm-light);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .boutique-card__badge--soon {
    color: var(--color-text);
    background: var(--color-warm-light);
  }

  .boutique-notice__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }

  .boutique-notice {
    background: var(--color-bg-light);
  }

  .boutique-notice__inner {
    text-align: center;
  }

  .boutique-notice__inner h2 {
    margin-bottom: var(--space-4);
  }

  .boutique-notice__inner p {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 640px) {
    .boutique-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .boutique-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
