---
interface Props {
  index?: number;
  caption: string;
  label: string;
  placeholderId?: string;
}

const { caption, label, placeholderId } = Astro.props;
---

<div
  class="media-placeholder"
  role="img"
  aria-label={label}
  data-massoda-placeholder={placeholderId}
>
  <span aria-hidden="true">{caption}</span>
</div>

<style>
  .media-placeholder {
    width: 100%;
    aspect-ratio: 2 / 1;
    background: color-mix(in srgb, var(--color-warm-light) 60%, var(--color-surface));
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    color: var(--color-text-light);
    font-size: var(--text-sm);
    text-align: left;
  }

  :global(div.boutique-card__image-wrap:has(> .media-placeholder)) {
    aspect-ratio: 2 / 1;
  }
</style>
