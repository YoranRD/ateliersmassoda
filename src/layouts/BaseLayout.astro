---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SOCIAL_LINKS } from '../data/site';
import '@fontsource-variable/raleway';
import ralewayLatin from '@fontsource-variable/raleway/files/raleway-latin-wght-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Les Ateliers Massoda — Ateliers créatifs, bien-être et lifestyle afro-caribéen.',
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL;
// base may or may not have a trailing slash depending on Astro version — normalise once
const basePath = base.endsWith('/') ? base : `${base}/`;
const canonicalURL = Astro.url.href.replace(/\/?$/, '/');

const siteOrigin = Astro.site ? Astro.site.origin : 'https://yoranrd.github.io';
// OG dérivée du mot-symbole officiel (fond crème, 1200x630)
const ogImagePath = ogImage ?? `${basePath}brand/og-masoda-v2.png`;
const absoluteOgImage = ogImagePath.startsWith('http')
  ? ogImagePath
  : `${siteOrigin}${ogImagePath}`;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Les Ateliers Massoda',
  url: `${siteOrigin}${basePath}`,
  logo: `${siteOrigin}${basePath}brand/nouveau_logo_crop.png`,
  sameAs: SOCIAL_LINKS.map(reseau => reseau.url),
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ECE9D9" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Les Ateliers Massoda" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Les Ateliers Massoda — visuel de marque" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />
  <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
  <link rel="apple-touch-icon" href={`${basePath}apple-touch-icon.png`} />
  <link rel="preload" href={ralewayLatin} as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

  {/*
    Analytics placeholder — intentionally disabled.
    To enable later, drop in a privacy-friendly provider snippet here.
    Recommended options: Plausible, Umami, or Cloudflare Web Analytics.
    Example (Plausible):
    <script defer data-domain="yoranrd.github.io/ateliersmassoda" src="https://plausible.io/js/script.js"></script>
  */}
</head>
<body>
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <Header />
  <main id="contenu" tabindex="-1">
    <div class="page-accent-line" aria-hidden="true"></div>
    <slot />
  </main>
  <Footer />

</body>
</html>
