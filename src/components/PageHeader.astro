---
interface Props {
  title: string;
  lede?: string;
  eyebrow?: string;
}

const { title, lede, eyebrow } = Astro.props;
const stacked = (lede?.length ?? 0) < 80 && !Astro.slots.has('default');
const wideTitle = title.length > 25;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <span class="overline page-header__eyebrow">{eyebrow}</span>}
    <div class:list={['page-header__grid', {
      'page-header__grid--stacked': stacked,
      'page-header__grid--wide-title': wideTitle && !stacked,
    }]}>
      <h1 class="heading-1">{title}</h1>
      <div class="page-header__content">
        {lede && <p class="subtitle page-header__lede">{lede}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .page-header {
    padding-block: var(--space-16) var(--space-12);
    background: var(--color-bg);
    text-align: left;
  }

  .page-header__eyebrow {
    display: block;
    margin-bottom: var(--space-3);
  }

  .page-header__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
  }

  .page-header__grid > * { min-width: 0; }

  .page-header__grid > h1 { text-wrap: balance; }

  .page-header__content :global(p) {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
  }

  .page-header__content :global(p + p) { margin-top: var(--space-4); }

  @media (min-width: 768px) {
    .page-header { padding-block: var(--space-24) var(--space-16); }
  }

  @media (min-width: 1024px) {
    .page-header__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-16);
      align-items: first baseline;
    }

    .page-header__content { padding-top: var(--space-2); }

    .page-header__grid--wide-title {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    }
  }

  .page-header__grid--stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .page-header__grid--stacked .page-header__content { padding-top: 0; }
  .page-header__grid--stacked .page-header__lede { font-size: var(--text-xl); }
</style>
