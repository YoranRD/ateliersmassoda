---
import { getNavHref } from '../utils/nav';
import { getReservationCta } from '../data/site';
import { getWorkshopViews } from '../data/workshops';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';

const base = import.meta.env.BASE_URL;

// Exactement la même source que l'accueil : aucune date, aucun prix,
// aucune image ni URL n'est redéfini ici.
const ateliers = getWorkshopViews();

// Aucune billetterie ouverte à ce jour : le CTA final ne promet pas de
// réservation et renvoie vers la liste des prochains ateliers.
const cta = getReservationCta('#prochains-ateliers');

const faqItems: FaqItem[] = [
  {
    question: 'Puis-je venir seul·e à un atelier ?',
    answer:
      'Bien sûr. Beaucoup de participant·es viennent seul·es. Nos expériences sont pensées comme des espaces de partage et de rencontre, et nous veillons à créer une ambiance chaleureuse afin que chacun·e puisse se sentir à l’aise dès son arrivée.',
  },
  {
    question: 'Puis-je venir accompagné·e ?',
    answer:
      'Avec plaisir. Selon les ateliers, nous proposons ponctuellement des tarifs préférentiels pour venir à deux. Certaines expériences sont mixtes et d’autres peuvent être pensées pour un public particulier : toutes les informations sont précisées sur la page de l’atelier.',
  },
  {
    question: 'Faut-il déjà savoir pratiquer l’activité ?',
    answer:
      'Non. Nos ateliers sont conçus pour permettre à chacun·e de découvrir, d’expérimenter et d’apprendre à son rythme. Les artistes, artisan·es et expert·es accompagnent le groupe tout au long de l’expérience.',
  },
  {
    question: 'Faut-il être issu·e de la communauté afrodescendante pour participer ?',
    answer:
      'Non. Les Ateliers Massoda sont ouverts à toutes et à tous. Nos expériences mettent à l’honneur les cultures afro-caribéennes, leurs savoirs, leurs pratiques et leurs créateur·rices dans une démarche de découverte, de transmission et de partage. Il n’est donc pas nécessaire d’être afrodescendant·e pour participer : nous demandons simplement de venir avec curiosité, respect et envie d’apprendre.',
  },
  {
    question: 'Le matériel est-il fourni ?',
    answer:
      'Oui. Sauf indication contraire, tout le matériel nécessaire est inclus dans la réservation. Il ne reste plus qu’à venir profiter de l’expérience.',
  },
  {
    question: 'Pourquoi le nombre de places est-il limité ?',
    answer:
      'Nous privilégions les petits groupes afin de préserver une expérience intimiste, de faciliter les échanges avec l’intervenant·e et de permettre à chacun·e d’être accompagné·e dans de bonnes conditions.',
  },
  {
    question: 'Où ont lieu les ateliers ?',
    answer:
      'Les expériences Massoda sont organisées dans différents lieux sélectionnés en fonction de l’univers de chaque atelier. L’adresse exacte est indiquée sur la page de réservation et dans la confirmation.',
  },
  {
    question: 'Comment être informé·e des prochains ateliers ?',
    answer:
      'En rejoignant La Lettre de Massoda, il est possible de découvrir la prochaine programmation et de bénéficier d’un accès prioritaire aux billetteries avant leur ouverture au public.',
  },
  {
    question: 'Les ateliers sont-ils uniquement créatifs ?',
    answer:
      'Non. Massoda explore la culture afro-caribéenne à travers différents aspects de l’art de vivre et du bien-être : créativité, alimentation, soin de soi, estime de soi, décoration, artisanat et bien d’autres pratiques. Chaque expérience est une nouvelle manière de découvrir, d’expérimenter et de se réapproprier ces savoirs.',
  },
];
---

<BaseLayout
  title="Ateliers & expériences — Les Ateliers Massoda"
  description="Rencontrez des artistes, artisan·es et expert·es afro-caribéen·nes le temps d’un atelier en petit comité, matériel fourni. Découvrez la prochaine programmation Massoda."
>
  <!-- 1. Introduction -->
  <section class="page-hero">
    <div class="container">
      <div class="page-hero__content reveal">
        <h1 class="heading-1">Ateliers &amp; expériences</h1>
        <p class="page-hero__lede">
          Les Ateliers Massoda créent des espaces de partage où les cultures afro-caribéennes
          se vivent à travers la créativité, le bien-être et l’art de vivre.
        </p>
        <p>
          Ouverts à toutes et à tous, nos ateliers invitent à rencontrer des artistes,
          artisan·es et expert·es, à découvrir leurs savoirs et leurs pratiques, puis à les
          expérimenter à sa manière.
        </p>
        <p>
          Chaque expérience est pensée en petit comité, avec un nombre de places limité et
          tout le matériel fourni, afin de profiter pleinement du moment.
        </p>
        <p>
          Que l’on vienne seul·e ou accompagné·e, Massoda est avant tout un espace de
          rencontre, de transmission et de convivialité.
        </p>
      </div>
    </div>
  </section>

  <!-- 2. Les trois prochains ateliers -->
  <section class="section prochains" id="prochains-ateliers">
    <div class="container">
      <h2 class="heading-2 prochains__title reveal">Nos trois prochains ateliers</h2>
      <div class="prochains__grid">
        {ateliers.map((atelier, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <WorkshopCard workshop={atelier} headingLevel="h3" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Questions & réponses -->
  <section class="section faq-section">
    <div class="container container--narrow reveal">
      <Faq title="Questions & réponses" items={faqItems} headingLevel="h2" />
    </div>
  </section>

  <!-- 4. CTA final -->
  <section class="section final-cta">
    <div class="container container--narrow final-cta__inner reveal">
      <h2 class="heading-3">Envie de vivre une expérience Massoda ?</h2>
      <p class="final-cta__text">
        La programmation se dévoile atelier après atelier. La Lettre de Massoda donne accès
        aux billetteries avant leur ouverture au public.
      </p>
      <div class="final-cta__actions">
        <a
          href={cta.href}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener' : undefined}
          class="btn btn--primary"
          data-massoda-placeholder={cta.isPlaceholder ? cta.placeholderId : undefined}
        >
          {cta.label}
        </a>
        <a href={`${getNavHref('', base)}#la-lettre`} class="btn btn--outline">
          Recevoir La Lettre
        </a>
      </div>
      <p class="final-cta__note">
        Un atelier privé, une collaboration ou un lieu à proposer ?
        <a href={getNavHref('contact', base)}>Écrivez-nous</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-block: var(--space-16) var(--space-12);
    background: var(--color-bg);
  }

  .page-hero__content {
    max-width: var(--measure);
  }

  .page-hero__content .overline {
    display: block;
    margin-bottom: var(--space-3);
  }

  .page-hero__content h1 {
    margin-bottom: var(--space-6);
  }

  .page-hero__content p {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }

  .page-hero__lede {
    font-size: var(--text-lg);
    color: var(--color-text) !important;
  }

  /* Prochains ateliers */
  .prochains {
    background: var(--color-bg-light);
    scroll-margin-top: var(--header-h);
  }

  .prochains__title {
    margin-bottom: var(--space-10);
  }

  .prochains__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .prochains__grid > * {
    min-width: 0;
    display: flex;
  }

  .prochains__grid > * > * {
    width: 100%;
  }

  /* FAQ */
  .faq-section {
    background: var(--color-bg);
  }

  /* CTA final */
  .final-cta {
    background: var(--color-bg-warm);
  }

  .final-cta__inner {
    text-align: center;
  }

  .final-cta__inner h2 {
    margin-bottom: var(--space-4);
  }

  .final-cta__text {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    margin-inline: auto;
    max-width: 46ch;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .final-cta__note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .final-cta__note a {
    color: var(--color-brand);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .page-hero {
      padding-block: var(--space-24) var(--space-16);
    }

    .prochains__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
