---
import { getNavHref } from '../utils/nav';
import { getAnnouncementCta, LETTER } from '../data/site';
import { getWorkshopViews } from '../data/workshops';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import { img } from '../utils/images';
import PageHeader from '../components/PageHeader.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';

const base = import.meta.env.BASE_URL;

// Exactement la même source que l'accueil : aucune date, aucun prix,
// aucune image ni URL n'est redéfini ici.
const ateliers = getWorkshopViews();

const cta = getAnnouncementCta();

const faqItems: FaqItem[] = [
  {
    question: 'Peut-on venir en solo ?',
    answer:
      'Bien sûr. Beaucoup de personnes viennent en solo. Nos expériences sont pensées comme des espaces de partage et de rencontre, et nous veillons à créer une ambiance chaleureuse afin que chacun puisse se sentir à l’aise dès son arrivée.',
  },
  {
    question: 'Peut-on venir à deux ou entre amis ?',
    answer:
      'Avec plaisir. Selon les ateliers, nous proposons ponctuellement des tarifs préférentiels pour venir à deux. Certaines expériences sont mixtes et d’autres peuvent être pensées pour un public particulier : toutes les informations sont précisées sur la page de l’atelier.',
  },
  {
    question: 'Faut-il déjà savoir pratiquer l’activité ?',
    answer:
      'Non. Nos ateliers sont conçus pour permettre à tout le monde de découvrir, d’expérimenter et d’apprendre à son rythme. Les personnes qui animent l’atelier accompagnent le groupe tout au long de l’expérience.',
  },
  {
    question: 'Faut-il faire partie de la communauté afrodescendante pour participer ?',
    answer:
      'Non. Les Ateliers Massoda sont ouverts à toutes et à tous. Nos expériences mettent à l’honneur les cultures afro-⁠caribéennes, leurs savoirs, leurs pratiques et celles et ceux qui les font vivre dans une démarche de découverte, de transmission et de partage. Il n’est donc pas nécessaire d’avoir des origines afrodescendantes pour participer : nous demandons simplement de venir avec curiosité, respect et envie d’apprendre.',
  },
  {
    question: 'Le matériel est-il fourni ?',
    answer:
      'Oui. Sauf indication contraire, tout le matériel nécessaire est inclus dans la réservation. Il ne reste plus qu’à venir profiter de l’expérience.',
  },
  {
    question: 'Pourquoi le nombre de places est-il limité ?',
    answer:
      'Nous privilégions les petits groupes afin de préserver une expérience intimiste, de faciliter les échanges avec la personne qui anime l’atelier et de permettre à chaque personne d’être bien accompagnée dans de bonnes conditions.',
  },
  {
    question: 'Où ont lieu les ateliers ?',
    answer:
      'À Paris. La plupart des ateliers se déroulent chez BMK Folie-Bamako (Paris 11e) ; d’autres ont lieu ponctuellement dans des lieux sélectionnés selon l’univers de l’expérience. L’adresse exacte est indiquée sur la page de réservation et dans la confirmation.',
  },
  {
    question: 'Comment suivre la prochaine programmation ?',
    answer:
      'En rejoignant La Lettre de Massoda, il est possible de découvrir la prochaine programmation et de bénéficier d’un accès prioritaire aux billetteries avant leur ouverture au public.',
  },
  {
    question: 'Les ateliers sont-ils uniquement créatifs ?',
    answer:
      'Non. Massoda explore la culture afro-⁠caribéenne à travers différents aspects de l’art de vivre et du bien-⁠être : créativité, alimentation, soin de soi, estime de soi, décoration, artisanat et bien d’autres pratiques. Chaque expérience est une nouvelle manière de découvrir, d’expérimenter et de se réapproprier ces savoirs.',
  },
];

const souvenirs = [
  { key: 'workshops/paint-jam-banner', caption: 'Atelier peinture — les gestes', alt: 'Une main peint des formes colorées sur une toile' },
  { key: 'home/communaute-masoda', caption: 'Atelier baya — la tablée', alt: 'Des personnes confectionnent des baya autour d’une table fleurie' },
  { key: 'home/atelier-paint-jam', caption: 'Atelier peinture — le partage', alt: 'Des personnes peignent ensemble autour d’une longue table' },
];

const pageHeader = {
  "title": "Ateliers & expériences",
  "lede": "Les Ateliers Massoda créent des espaces de partage où les cultures afro-⁠caribéennes se vivent à travers la créativité, le bien-⁠être et l’art de vivre."
};
---

<BaseLayout
  title="Ateliers & expériences — Les Ateliers Massoda"
  description="Rencontrer des artistes et des personnes expertes le temps d’un atelier en petit comité, à Paris, matériel fourni : la programmation des Ateliers Massoda."
>
  <!-- 1. Introduction -->
  <PageHeader {...pageHeader}>
    <p>
      Ouverts à toutes et à tous, nos ateliers invitent à rencontrer des artistes et
      des personnes expertes de leur pratique, à découvrir leurs savoirs et leurs pratiques, puis à les
      expérimenter à sa manière.
    </p>
    <p>
      Chaque expérience est pensée en petit comité, avec un nombre de places limité et
      tout le matériel fourni, afin de profiter pleinement du moment.
    </p>
    <p>
      Que l’on vienne en solo, à deux ou entre amis, Massoda est avant tout un espace de
      rencontre, de transmission et de convivialité.
    </p>
    <div class="ateliers-location">
      <h2 class="heading-4">Où se déroulent les ateliers ?</h2>
      <p>La plupart de nos ateliers ont lieu chez BMK Folie-Bamako, 40 rue Jean-Pierre Timbaud, Paris 11e, un lieu qui accueille fidèlement nos expériences. D’autres se déroulent ponctuellement dans des lieux choisis pour leur univers. L’adresse exacte figure toujours sur la page de réservation.</p>
    </div>
  </PageHeader>

  <!-- 2. Les trois prochains ateliers -->
  <section class="section prochains" id="prochains-ateliers">
    <div class="container">
      <div class="prochains__header">
        <h2 class="heading-2 prochains__title">Nos trois prochains ateliers</h2>
        {ateliers.some(atelier => atelier.hasPlaceholder) && (
          <p class="prochains__note">Dates, lieux et billetteries seront annoncés ici dès leur ouverture.</p>
        )}
      </div>
      <div class="prochains__grid">
        {ateliers.map((atelier, i) => (
          <div>
            <WorkshopCard workshop={atelier} headingLevel="h3" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section souvenirs">
    <div class="container">
      <h2 class="heading-2 souvenirs__title">Souvenirs d’ateliers</h2>
      <p class="souvenirs__lede">Quelques moments partagés lors de nos ateliers précédents.</p>
      <div class="souvenirs__row" role="region" aria-label="Souvenirs d’ateliers" tabindex="0">
        {souvenirs.map(souvenir => (
          <figure>
            <Picture
              src={img(souvenir.key)}
              alt={souvenir.alt}
              class="souvenirs__photo"
              formats={['avif', 'webp']}
              widths={[400, 640, 900]}
              sizes="(min-width:1200px) 347px, (min-width:1024px) calc((100vw - 160px) / 3), (min-width:768px) calc((100vw - 112px) / 3), calc((100vw - 48px) * 0.78)"
              loading="lazy"
              width={img(souvenir.key).width}
              height={img(souvenir.key).height}
            />
            <figcaption>{souvenir.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Questions & réponses -->
  <section class="section faq-section">
    <div class="container container--narrow">
      <Faq title="Questions & réponses" items={faqItems} headingLevel="h2" />
    </div>
  </section>

  <!-- 4. CTA final -->
  <section class="section final-cta">
    <div class="container container--narrow final-cta__inner">
      <h2 class="heading-3">Envie de vivre une expérience Massoda ?</h2>
      <p class="final-cta__text">
        {cta.kind === 'instagram' ? cta.message : (
          <>La programmation se dévoile atelier après atelier. La Lettre de Massoda donne accès
          aux billetteries avant leur ouverture au public.</>
        )}
      </p>
      <div class="final-cta__actions">
        <a
          href={cta.href}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener' : undefined}
          class="btn btn--primary"
          data-massoda-placeholder={cta.isPlaceholder ? cta.placeholderId : undefined}
        >
          {cta.label}
        </a>
        {cta.kind === 'reservation' && LETTER.signupUrl && (
          <a href={LETTER.signupUrl ?? getNavHref('la-lettre', base)} target={LETTER.signupUrl ? '_blank' : undefined} rel={LETTER.signupUrl ? 'noopener' : undefined} class="btn btn--outline">
            Recevoir La Lettre
          </a>
        )}
      </div>
      <p class="final-cta__note">
        Un atelier privé, une collaboration ou un lieu à proposer ?
        <a href={getNavHref('contact', base)}>Écrivez-nous</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .ateliers-location { margin-top: var(--space-8); }
  .ateliers-location h2 { margin-bottom: var(--space-3); }

  .souvenirs__title { margin-bottom: var(--space-3); }
  .souvenirs__lede {
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
  }

  .souvenirs__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .souvenirs__row::-webkit-scrollbar { display: none; }
  .souvenirs__row figure { min-width: 0; scroll-snap-align: start; }
  .souvenirs__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .souvenirs__row figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  @media (min-width: 768px) {
    .souvenirs__row {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      scroll-snap-type: none;
    }
  }


  /* Prochains ateliers */
  .prochains {
    background: var(--color-bg-light);
  }

  .prochains__header {
    margin-bottom: var(--space-10);
  }

  .prochains__note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .prochains__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .prochains__grid > * {
    min-width: 0;
    display: flex;
  }

  .prochains__grid > * > * {
    width: 100%;
  }

  /* FAQ */
  .faq-section {
    background: var(--color-bg);
  }

  /* CTA final */
  .final-cta {
    background: var(--color-bg-warm);
  }

  .final-cta__inner {
    text-align: center;
  }

  .final-cta__inner h2 {
    margin-bottom: var(--space-4);
  }

  .final-cta__text {
    color: var(--color-text-light);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    margin-inline: auto;
    max-width: 46ch;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .final-cta__actions .btn { white-space: normal; }

  .final-cta__note {
    margin-top: var(--space-8);
    font-size: var(--text-sm);
    color: var(--color-text-light);
  }

  .final-cta__note a {
    color: var(--color-brand);
    font-weight: var(--weight-semibold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {

    .prochains__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
