---
import { getNavHref } from '../utils/nav';
import { SOCIAL_LINKS } from '../data/site';

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
const year = new Date().getFullYear();
const homeHref = getNavHref('', base);
const logoUrl = `${basePath}brand/nouveau_logo_crop.png`;
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <!-- Brand -->
      <div class="footer__brand">
        <!-- Footer clair : le mot-symbole bleu s'affiche directement,
             sans plaque ni fond sombre qui l'écraserait. -->
        <a href={homeHref} class="footer__logo-link" aria-label="Les Ateliers Massoda — Accueil">
          <img
            src={logoUrl}
            alt="Les Ateliers Massoda"
            class="footer__logo-img"
            width="355"
            height="154"
            loading="lazy"
          />
        </a>
        <p class="footer__tagline">Ateliers créatifs, bien-être<br/>et lifestyle afro-caribéen.</p>
      </div>

      <!-- Navigation -->
      <div class="footer__col">
        <h2 class="footer__heading">Navigation</h2>
        <ul class="footer__links">
          <li><a href={homeHref}>Accueil</a></li>
          <li><a href={getNavHref('ateliers', base)}>Ateliers &amp; expériences</a></li>
          <li><a href={`${homeHref}#la-lettre`}>La Lettre</a></li>
          <li><a href={getNavHref('a-propos', base)}>À propos</a></li>
          <li><a href={getNavHref('contact', base)}>Collaborer</a></li>
        </ul>
      </div>

      <!-- Explorer -->
      <div class="footer__col">
        <h2 class="footer__heading">Explorer</h2>
        <ul class="footer__links">
          <li><a href={getNavHref('boutique', base)}>Boutique</a></li>
          <li><a href={getNavHref('journal', base)}>Journal</a></li>
        </ul>
      </div>

      <!-- Réseaux -->
      <div class="footer__col">
        <h2 class="footer__heading">Suivez-nous</h2>
        <ul class="footer__links">
          {SOCIAL_LINKS.map(reseau => (
            <li><a href={reseau.url} target="_blank" rel="noopener">{reseau.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} Les Ateliers Massoda. Tous droits réservés.</p>
      <ul class="footer__legal">
        <li><a href={getNavHref('mentions-legales', base)}>Mentions légales</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-warm);
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-16) var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  .footer__logo-link {
    display: inline-flex;
    align-items: center;
    margin-bottom: var(--space-5);
  }

  .footer__logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    line-height: var(--leading-normal);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-brand);
    margin-bottom: var(--space-4);
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__links a {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    transition: color var(--duration-fast);
  }

  .footer__links a:hover {
    color: var(--color-brand);
  }

  .footer__bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .footer__bottom p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__legal a {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    transition: color var(--duration-fast);
  }

  .footer__legal a:hover {
    color: var(--color-brand);
  }

  @media (min-width: 640px) {
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
    .footer__logo-img { height: 42px; }
  }
</style>
