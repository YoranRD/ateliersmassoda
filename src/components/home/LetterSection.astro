---
import { LETTER, PLACEHOLDER_LABELS } from '../../data/site';

/* MASSODA_MISSING:LETTER_SIGNUP_URL — sans URL réelle, aucun href n'est
   fabriqué et aucun formulaire n'est simulé. Renseigner LETTER.signupUrl
   dans src/data/site.ts rend le CTA cliquable automatiquement. */
const hasSignup = Boolean(LETTER.signupUrl);
---

<section class="lettre on-brand" id={LETTER.anchorId}>
  <div class="container lettre__inner reveal">
    <span class="lettre__eyebrow">La Lettre de Massoda</span>
    <h2 class="heading-3 lettre__titre">L’accès prioritaire aux billetteries</h2>
    <div class="lettre__texte">
      <p>
        Bien avant d’être un concept, <strong>Massoda qui est le fruit d’un cheminement.</strong>
      </p>
      <p>
        Celui d’apprendre à mieux se connaître, de questionner ce que l’on nous a transmis,
        d’expérimenter de nouvelles façons de prendre soin de soi et de créer du lien avec les
        autres.
      </p>
      <p>
        Parce que nous prenons rarement le temps de nous arrêter, d’être curieux, d’essayer,
        de nous questionner. Pourtant, je crois que ces moments participent profondément à
        notre bien-être.
      </p>
      <p><strong>La Lettre Massoda</strong>, c’est un peu le prolongement de cette réflexion.</p>
      <p>
        Chaque mois, je t’y partagerai les questionnements, rencontres et découvertes qui
        nourrissent Massoda et donnent naissance aux ateliers. Mais aussi mes recommandations :
        lieux, food, bien-être, culture, activités et belles découvertes à expérimenter.
      </p>
      <p>
        Et parce que cette lettre est aussi une façon de réunir celles et ceux qui souhaitent
        suivre Massoda de plus près, <strong>ses abonnés auront accès en avant-première aux
        billetteries de tous les ateliers du trimestre</strong>, avant leur annonce sur
        Instagram.
      </p>
      <p>
        Une lettre pour découvrir, expérimenter, s’inspirer… et peut-être voir son quotidien
        autrement.
      </p>
    </div>

    {hasSignup ? (
      <a href={LETTER.signupUrl} target="_blank" rel="noopener" class="lettre__btn">
        {LETTER.ctaLabel}
      </a>
    ) : (
      <p class="lettre__pending" data-massoda-placeholder="LETTER_SIGNUP_URL">
        {PLACEHOLDER_LABELS.letterSignup}
      </p>
    )}
  </div>
</section>

<style>
  /* Section accentuée de l'accueil : bleu de marque, texte clair. */
  .lettre {
    background: var(--color-brand);
    padding-block: var(--space-16);
    position: relative;
    overflow: hidden;
    /* Compense le header collant lors d'un saut sur #la-lettre. */
    scroll-margin-top: var(--header-h);
  }

  .lettre::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-warm) 32%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }

  .lettre__inner {
    position: relative;
    text-align: center;
    max-width: 620px;
  }

  .lettre__eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-warm-light);
    margin-bottom: var(--space-4);
  }

  .lettre__titre {
    color: var(--color-text-on-brand);
    margin-bottom: var(--space-4);
  }

  .lettre__texte {
    color: color-mix(in srgb, var(--color-text-on-brand) 88%, transparent);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-8);
    margin-inline: auto;
    text-align: left;
  }

  .lettre__texte p + p {
    margin-top: var(--space-4);
  }

  .lettre__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-10);
    background: var(--color-bg);
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-full);
    transition: background var(--duration-normal) var(--ease-out),
                transform var(--duration-normal) var(--ease-out);
  }

  .lettre__btn:hover {
    background: var(--color-surface);
    transform: translateY(-2px);
  }

  /* État temporaire : visuellement abouti, mais non cliquable. */
  .lettre__pending {
    display: inline-block;
    padding: var(--space-4) var(--space-10);
    border: 1px dashed color-mix(in srgb, var(--color-text-on-brand) 55%, transparent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-on-brand);
  }
</style>
