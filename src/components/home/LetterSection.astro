---
import { LETTER } from '../../data/site';
import { getNavHref } from '../../utils/nav';
import LetterContent from '../letter/LetterContent.astro';
import LetterAction from '../letter/LetterAction.astro';
const base = import.meta.env.BASE_URL;
---

<section class="lettre letter-surface on-brand" id={LETTER.anchorId}>
  <div class="container lettre__inner">
    <span class="overline lettre__eyebrow">La Lettre de Massoda</span>
    <h2 class="heading-3 lettre__titre">L’accès prioritaire aux billetteries</h2>
    <div class="lettre__texte">
      <LetterContent excerpt />
    </div>
    <a href={getNavHref('la-lettre', base)} class="lettre__read-link">Lire la lettre en entier</a>
    <LetterAction />
  </div>
</section>

<style>
  .lettre__inner {
    position: relative;
    text-align: center;
    max-width: 620px;
  }

  .lettre__eyebrow {
    display: block;
    color: var(--color-warm-light);
    margin-bottom: var(--space-4);
  }

  .lettre__titre {
    color: var(--color-text-on-brand);
    margin-bottom: var(--space-4);
  }

  .lettre__texte {
    color: color-mix(in srgb, var(--color-text-on-brand) 88%, transparent);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
    text-align: left;
  }

  .lettre__read-link {
    display: inline-block;
    color: var(--color-text-on-brand);
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-bottom: var(--space-8);
    padding-block: var(--space-2);
  }
</style>
