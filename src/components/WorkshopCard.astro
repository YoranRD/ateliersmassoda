---
/**
 * Carte d'atelier réutilisable — utilisée par l'accueil et par
 * /ateliers/. Toute la logique de repli vit dans
 * src/data/workshops.ts : renseigner une vraie valeur là-bas met
 * à jour les deux pages sans toucher à ce composant.
 */
import type { WorkshopView } from '../data/workshops';

interface Props {
  workshop: WorkshopView;
  /** Niveau de titre, pour respecter la hiérarchie de la page hôte. */
  headingLevel?: 'h3' | 'h4';
}

const { workshop, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

const base = import.meta.env.BASE_URL;
const basePath = base.endsWith('/') ? base : `${base}/`;
---

<article class="workshop-card card">
  {workshop.image.kind === 'image' ? (
    <img
      src={`${basePath}${workshop.image.src}`}
      alt={workshop.image.alt}
      class="workshop-card__image"
      loading="lazy"
      width="800"
      height="600"
    />
  ) : (
    /* MASSODA_MISSING: visuel non fourni — bloc de marque, jamais d'image cassée */
    <div
      class="workshop-card__image workshop-card__image--placeholder"
      data-massoda-placeholder={workshop.image.placeholderId}
      role="img"
      aria-label={`${workshop.title} — ${workshop.image.label}`}
    >
      <span class="workshop-card__placeholder-mark" aria-hidden="true">✦</span>
      <span class="workshop-card__placeholder-text" aria-hidden="true">{workshop.image.label}</span>
    </div>
  )}

  <div class="card__body workshop-card__body">
    <span class="card__tag">{workshop.tag}</span>
    <Heading class="card__title">{workshop.title}</Heading>

    {workshop.description && <p class="card__text workshop-card__desc">{workshop.description}</p>}

    <dl class="workshop-card__practical">
      {workshop.practical.map((item) => (
        <div class="workshop-card__row">
          <dt>{item.label}</dt>
          <dd
            class:list={['workshop-card__value', { 'workshop-card__value--pending': item.status === 'placeholder' }]}
            data-massoda-placeholder={item.status === 'placeholder' ? item.placeholderId : undefined}
          >
            {item.text}
          </dd>
        </div>
      ))}
    </dl>

    <div class="workshop-card__action">
      {workshop.action.kind === 'book' ? (
        <a href={workshop.action.url} target="_blank" rel="noopener" class="btn btn--primary workshop-card__btn">
          {workshop.action.label}
        </a>
      ) : (
        /* Billetterie non ouverte : mention non cliquable, jamais de faux bouton */
        <p
          class="workshop-card__pending"
          data-massoda-placeholder={workshop.action.placeholderId}
        >
          {workshop.action.label}
        </p>
      )}
    </div>
  </div>
</article>

<style>
  .workshop-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
  }

  .workshop-card__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* Repli graphique de marque : clairement temporaire, jamais confondable
     avec une photo réelle de l'atelier. */
  .workshop-card__image--placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background:
      repeating-linear-gradient(
        135deg,
        var(--color-surface-warm) 0 14px,
        var(--color-bg-warm) 14px 28px
      );
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-light);
  }

  .workshop-card__placeholder-mark {
    font-size: var(--text-2xl);
    color: var(--color-warm);
    line-height: 1;
  }

  .workshop-card__placeholder-text {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
  }

  .workshop-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .workshop-card__desc {
    margin-bottom: var(--space-4);
  }

  .workshop-card__practical {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .workshop-card__row {
    display: flex;
    gap: var(--space-3);
    align-items: baseline;
  }

  .workshop-card__row dt {
    flex: 0 0 5.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
  }

  .workshop-card__value {
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  /* Valeur encore temporaire : ton plus discret + italique, pour qu'elle
     ne se lise jamais comme une information commerciale définitive. */
  .workshop-card__value--pending {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .workshop-card__action {
    margin-top: auto;
    padding-top: var(--space-6);
  }

  .workshop-card__btn {
    width: 100%;
  }

  .workshop-card__pending {
    display: block;
    padding: var(--space-3) var(--space-4);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-full);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-light);
    background: var(--color-surface-warm);
  }
</style>
